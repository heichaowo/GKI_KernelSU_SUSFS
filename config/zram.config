# --- ZRAM 核心支持 ---
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZSmalloc=y

# --- 高效压缩算法 (内核原生支持) ---
# ZSTD 是目前 Pixel 设备的首选，压缩比极高
CONFIG_CRYPTO_ZSTD=y
# LZ4 依然保留，作为处理“热数据”的备选
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y

# --- 进阶性能优化 ---
# 允许将 ZRAM 中不常用的数据写回到磁盘（需配合底层分区支持）
CONFIG_ZRAM_WRITEBACK=y
# 允许追踪压缩效率和内存碎片，方便调试
CONFIG_ZRAM_TRACK_ENTRY_STATS=y
CONFIG_ZRAM_MEMORY_TRACKING=y
